{
  "name": "nuxdmin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "🚀 Modern admin dashboard template built with Nuxt 4, TypeScript, and Nuxt UI",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:oxlint": "oxlint",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/ui": "^3.0.0",
    "@pinia/nuxt": "0.11.3",
    "nuxt": "^3.15.0",
    "nuxt-auth-utils": "^0.5.0",
    "tailwindcss": "^4.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@nuxt/test-utils": "^3.14.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.15.0",
    "eslint-plugin-oxlint": "^1.49.0",
    "happy-dom": "^15.0.0",
    "oxfmt": "^0.7.0",
    "oxlint": "^0.11.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}
